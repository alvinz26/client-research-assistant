# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Model used for both calls. claude-haiku-5-5 is much cheaper; see README.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Maximum web searches per report.
MAX_SEARCHES=8

# Set to 1 to run on built-in sample data even when a key is present.
DEMO_MODE=0
